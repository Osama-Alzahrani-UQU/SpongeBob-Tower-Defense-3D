; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for AI assistance it is generated with standard conventions.

config_version=5

[application]

config/name="SpongeBob Tower Defense (3D)"
config/description="Official 3D Tower Defense Game Created & Owned by Osama-Alzahrani-UQU (https://github.com/Osama-Alzahrani-UQU)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "forward_plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
PlayerData="*res://scripts/autoload/player_data.gd"
ModelBuilder3D="*res://scripts/autoload/model_builder_3d.gd"
UIThemeBuilder="*res://scripts/autoload/ui_theme_builder.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[internationalization]

rendering/root_node_layout_direction=1

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.03, 0.1, 0.18, 1)
